# Azure DevOps Configuration
AZURE_ORG="morestudio"
AZURE_PROJECT="M"
AZURE_PAT="your_azure_personal_access_token_here"
AZURE_QUERY_ID="your_azure_query_id_here"

# Firebase Configuration
# You must download your Service Account JSON from Firebase Console > Project Settings > Service Accounts
# Compress the JSON string into a single line to paste it here or into GitHub Secrets.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'
